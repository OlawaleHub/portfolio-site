# Normalise line endings in the repository so Windows and macOS/Linux
# checkouts produce identical content and clean diffs.
* text=auto eol=lf

# Binary assets — never touch these
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary

# Generated artwork is text but should keep exact bytes
*.svg text eol=lf

# Windows scripts
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
